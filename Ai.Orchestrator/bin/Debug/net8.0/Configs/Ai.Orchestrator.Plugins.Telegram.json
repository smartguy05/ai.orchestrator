{
    "name": "Ai.Orchestrator.Plugins.Telegram",
    "description": "A plugin to allow communication using the Telegram service",
    "tools": [
        {
            "type": "function",
            "function": {
                "name": "send_telegram",
                "description": "Send a telegram message from to the User using a bot account.",
                "parameters": {
                    "type": "object",
                    "properties": {
                        "chatId": {
                            "type": "string",
                            "description": "The current chat id to send messages to"
                        },
                        "messageText": {
                            "type": "string",
                            "description": "The text of the message to send"
                        }
                    },
                    "required": [
                        "messageText"
                    ]
                }
            }
        }
    ],
    "botToken": "your-bot-token",
    "aiPlugin": "Ai.Orchestrator.Plugins.OpenAI",
    "notificationChatId": "your-notification-id-from-bot-father"
}